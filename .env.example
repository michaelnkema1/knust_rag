# Copy to .env and fill in. Any OpenAI-compatible endpoint works.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Retrieval / chunking experiment settings
RETRIEVAL_MODE=vector   # vector | bm25 | hybrid
TOP_K=5
CHUNK_SIZE=600
CHUNK_OVERLAP=100
EMBED_MODEL=BAAI/bge-small-en-v1.5
